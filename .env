# ─────────────────────────────────────────────────────────────────────────────
# Jelly-Claude .env — copy to .env and fill in your keys
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Choose ONE: Anthropic (paid Claude models) OR OpenRouter (free/cheap) ────

# Option A: Anthropic API key — get one at https://console.anthropic.com
# Uses Claude's default paid model tiers automatically.
ANTHROPIC_API_KEY=

# Option B: OpenRouter API key — get one at https://openrouter.ai/keys
# jelly-claude.sh will configure the free/low-cost model tiers below.
OPENROUTER_API_KEY=

# ── Alchemy ─────────────────────────────────────────────────────────────────
ALCHEMY_API_KEY=
ALCHEMY_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ETH_WSS=wss://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SOL_RPC=https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SOL_WSS=wss://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_WSS=wss://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ARB_WSS=wss://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_POLYGON_WSS=wss://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# ── OpenRouter model tiers (auto-set by jelly-claude.sh — override if needed) ─
# These are only used when OPENROUTER_API_KEY is set and ANTHROPIC_API_KEY is not.
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek/deepseek-v4-pro
# ANTHROPIC_DEFAULT_SONNET_MODEL=x-ai/grok-4.3
# ANTHROPIC_DEFAULT_HAIKU_MODEL=nvidia/nemotron-3-nano-30b-a3b:exacto
# CLAUDE_CODE_SUBAGENT_MODEL=qwen/qwen3-next-80b-a3b-thinking

# sports-jelly-sdk — Environment Variables
# Copy this file to .env and fill in the values you need.
# All keys are optional in v0.1 (all providers are typed stubs).

# ─── Free tier — key required ────────────────────────────────────────────────

# BallDontLie — NBA, NFL, MLB, NHL, EPL, MMA, FIFA WC
# Sign up: https://app.balldontlie.io  |  Limit: 5 req/min
BALLDONTLIE_API_KEY=

# API-Sports (api-sports.io) — Football, NBA, NFL, F1, Tennis, Rugby, Baseball
# Sign up: https://dashboard.api-sports.io  |  Limit: 100 req/day
SPORTS_API_KEY=

# football-data.org — Football only (12 major competitions)
# Sign up: https://www.football-data.org/client/register  |  Limit: 10 req/min
FOOTBALL_DATA_API_KEY=

# Sportmonks — Football, Cricket, F1  (limited leagues free forever)
# Sign up: https://www.sportmonks.com/register
SPORTMONKS_API_KEY=

# The Odds API — NFL, NBA, Soccer, Tennis, MLB, NHL+
# Sign up: https://the-odds-api.com/#get-access  |  Limit: 500 req/month
ODDS_API_KEY=

# MySportsFeeds — NFL, MLB, NBA, NHL (free for personal use)
# Sign up: https://www.mysportsfeeds.com/data-feeds/signup
MYSPORTSFEEDS_API_KEY=

# TheSportsDB v2 Patreon extended key
# https://www.patreon.com/thesportsdb
THESPORTSDB_PATREON_KEY=

# ─── Free — no key required ──────────────────────────────────────────────────
# TheSportsDB v1: https://www.thesportsdb.com/api/v1/json/3/ (no key needed)

# ─── Paid — trial or enterprise ──────────────────────────────────────────────

# SportsDataIO — NFL, NBA, MLB, NHL, Tennis, Golf, Soccer  (14-day trial, scrambled)
SPORTSDATA_IO_KEY=

# Sportradar — 80+ sports (B2B enterprise pricing)
SPORTRADAR_API_KEY=

# iSports API — Football (1600+ leagues), Basketball 300+ (freemium, strong Asia-Pacific)
ISPORTS_API_KEY=

# ─── Market providers ────────────────────────────────────────────────────────
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=

# ─── SDK settings ────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=120
SDK_DEBUG=
