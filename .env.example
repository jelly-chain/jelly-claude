# ─────────────────────────────────────────────────────────────────────────────
# Jelly-Claude .env — copy to .env and fill in your keys
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider — pick ONE ──────────────────────────────────────────────────

# Option A: Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option B: OpenRouter API key — https://openrouter.ai/keys
# Enables free/cheap model routing via jelly-claude.sh model config
OPENROUTER_API_KEY=

# ── Model tier overrides (auto-configured by jelly-claude.sh) ────────────────
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
# CLAUDE_CODE_SUBAGENT_MODEL=claude-haiku-4-5

# ── Token Budget ─────────────────────────────────────────────────────────────
# Hard cap on total tokens per agent invocation (input + output)
JELLY_TOKEN_BUDGET=50000

# ── Solana ───────────────────────────────────────────────────────────────────

# Helius — enhanced Solana RPC + webhooks + parsed transactions
# Free tier: 100k credits/mo | Sign up: https://dev.helius.xyz
HELIUS_API_KEY=

# Helius webhook secret (for push-based new token / swap alerts)
HELIUS_WEBHOOK_SECRET=

# Your Solana wallet for reading balance / sending transactions
SOLANA_PRIVATE_KEY=
SOLANA_WALLET_ADDRESS=

# ── EVM Chains ───────────────────────────────────────────────────────────────

# EVM private key (hex, 0x prefix) — used for BNB, Base, Polygon, Ethereum, Arbitrum
EVM_PRIVATE_KEY=
EVM_WALLET_ADDRESS=

# ── Alchemy RPC (recommended — much faster than public nodes) ─────────────────
# Sign up: https://dashboard.alchemy.com  Free: 300M compute units/mo
ALCHEMY_API_KEY=
ALCHEMY_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ETH_WSS=wss://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SOL_RPC=https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SOL_WSS=wss://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BASE_WSS=wss://base-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ARB_WSS=wss://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_POLYGON_WSS=wss://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_BNB_RPC=https://bnb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# ── Prediction Markets ───────────────────────────────────────────────────────

# Polymarket — CLOB trading (sign in at https://polymarket.com → get API keys)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Kalshi — US regulated prediction market (https://kalshi.com/account/api)
KALSHI_API_KEY=
KALSHI_API_SECRET=

# predict.fun — BNB Chain CLOB (https://predict.fun)
PREDICT_API_KEY=

# ── On-chain Analytics ───────────────────────────────────────────────────────

# Birdeye — Solana + multi-chain token analytics
# Free: 50 req/min | Sign up: https://birdeye.so/apikeys
BIRDEYE_API_KEY=

# ── Price Data (all free, no key needed unless noted) ────────────────────────
# DexScreener:   https://api.dexscreener.com  (free, no key)
# CoinGecko:     https://api.coingecko.com    (free, 30 req/min)
# Pyth Network:  https://hermes.pyth.network  (free, no key, real-time)
# Coinpaprika:   https://api.coinpaprika.com  (free, no key)
# Jupiter Price: https://price.jup.ag         (free, no key, Solana)
# DeFiLlama:     https://api.llama.fi         (free, no key)
# Hyperliquid:   https://api.hyperliquid.xyz  (free, no key)
# Fear & Greed:  https://api.alternative.me   (free, no key)

# CoinGecko PRO — higher rate limits (optional)
# COINGECKO_API_KEY=

# ── News & Sentiment ─────────────────────────────────────────────────────────

# CryptoPanic — crypto news with sentiment scoring
# Free: 1000 req/day | Sign up: https://cryptopanic.com/developers/api
CRYPTOPANIC_API_KEY=

# NewsAPI — general news (useful for macro prediction markets)
# Free: 100 req/day | Sign up: https://newsapi.org
NEWSAPI_KEY=

# ── Telegram Bot (optional) ──────────────────────────────────────────────────

# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ── WebSocket Server ──────────────────────────────────────────────────────────
# Port for local real-time WebSocket event stream (dashboard / extensions)
JELLY_WS_PORT=3099

# ── Voice (optional) ─────────────────────────────────────────────────────────
VOICE_ENABLED=false
VOICE_MODEL=whisper-1

# ── Sports Data (prediction market signal enrichment) ────────────────────────

# BallDontLie — NBA, NFL, MLB, NHL, EPL, MMA
# Free: 5 req/min | Sign up: https://app.balldontlie.io
BALLDONTLIE_API_KEY=

# The Odds API — live odds across 20+ sports (prediction market edge)
# Free: 500 req/month | Sign up: https://the-odds-api.com
ODDS_API_KEY=

# API-Sports — football, NBA, F1, tennis (100 req/day free)
# Sign up: https://dashboard.api-sports.io
SPORTS_API_KEY=

# ── Macro Data (prediction market signal enrichment) ─────────────────────────

# Polygon.io — stocks, forex, crypto OHLCV (useful for election/rate markets)
# Free: unlimited delayed | Sign up: https://polygon.io
POLYGON_IO_API_KEY=

# Messari — on-chain metrics for BTC/ETH (research + prediction alpha)
# Free tier: no key needed for basic endpoints
# Pro: https://messari.io/api
MESSARI_API_KEY=

# FRED (Federal Reserve Economic Data) — interest rates, CPI, unemployment
# Free: unlimited | Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage — stocks/forex/crypto OHLCV + technical indicators
# Free: 25 req/day | Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Social Signals ────────────────────────────────────────────────────────────

# LunarCrush — social volume + engagement metrics per token
# Free tier limited | Sign up: https://lunarcrush.com/developers
LUNARCRUSH_API_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# Session ID for audit ledger entries
JELLY_SESSION_ID=

# ── Advanced / Optional ───────────────────────────────────────────────────────

# Jito Block Engine — Solana MEV bundle submission
# No key needed for public endpoint
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Squads Protocol — Solana multisig
# SQUADS_PROGRAM_ID=SQDS4ep65T869zMMBKyuUq6aD6EgTu8psMjkvj52pCf

# Hyperliquid perps private key (if trading perps — separate from EVM key)
# HYPERLIQUID_PRIVATE_KEY=

# ── Sports Jelly SDK extra keys ───────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=
SPORTMONKS_API_KEY=
MYSPORTSFEEDS_API_KEY=
SPORTSDATA_IO_KEY=
SPORTRADAR_API_KEY=
THESPORTSDB_PATREON_KEY=
ISPORTS_API_KEY=

# ── NEW SDK Keys (v2.2.0+) ───────────────────────────────────────────────────

# Sportradar — Tier 1 sports data (80+ sports)
# Sign up: https://sportradar.com
# SPORTRADAR_API_KEY=  (already defined above)

# Metaculus — Crowd forecasting platform
# Sign up: https://www.metaculus.com/accounts/signup/
METACULUS_API_TOKEN=

# Manifold Markets — Play-money prediction market (optional)
# Sign up: https://manifold.markets
MANIFOLD_API_KEY=

# Betfair Exchange — World's largest betting exchange
# Sign up: https://betfair.com/developers
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# PredictIt — Political prediction markets
# Sign up: https://www.predictit.org
PREDICTIT_API_KEY=

# Eventbrite — Event data for market triggers
# Sign up: https://www.eventbrite.com/platform/api
EVENTBRITE_TOKEN=

# Ticketmaster — Event data for market triggers
# Sign up: https://developer.ticketmaster.com
TICKETMASTER_KEY=

# PandaScore — Esports data (LoL, CS2, Dota 2, Valorant)
# Sign up: https://pandascore.co
PANDASCORE_API_KEY=

# CricAPI — Cricket data (IPL, ICC, Big Bash)
# Sign up: https://cricapi.com
CRICAPI_KEY=

# OpenWeatherMap — Weather data for outdoor sports venues
# Sign up: https://openweathermap.org/api
WEATHER_API_KEY=

# Referee Data Provider — Referee assignment data
REFEREE_API_KEY=

# ── SDK Configuration ─────────────────────────────────────────────────────────

# Path to SDK-main directory (relative to jelly-claude directory)
SDK_PATH=../SDK-main

# Enable/disable specific SDKs (comma-separated)
# SDK_ENABLED=sportradar,polymarket-clob,kalshi-v3,metaculus,espn-live

# SDK cache TTL in seconds (default: 120)
SDK_CACHE_TTL=120

# SDK request timeout in milliseconds (default: 10000)
SDK_TIMEOUT=10000
