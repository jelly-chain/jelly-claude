{
  "name": "jelly-claude",
  "version": "2.1.0",
  "description": "Multi-chain AI agent powered by Claude Code — Solana, BNB, Polygon, Polymarket, Kalshi, predict.fun and more",
  "type": "module",
  "author": "jelly-chain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jelly-chain/jelly-claude.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node jelly-claude.mjs",
    "proxy": "node proxy.mjs",
    "health": "node scripts/health-check.mjs",
    "check": "node scripts/check-deps.mjs",
    "reset": "node scripts/reset.mjs",
    "wallet": "node scripts/generate-wallet.mjs",
    "install-skills": "node scripts/install-skills.mjs",
    "install-agents": "node scripts/install-agents.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest tests/ --passWithNoTests",
    "test:core": "node tests/core.test.mjs",
    "test:prediction": "node tests/prediction.test.mjs",
    "test:memory": "node tests/memory.test.mjs",
    "test:platform": "node tests/platform.test.mjs",
    "test:errors": "node tests/app-error.test.mjs",
    "test:journal": "node tests/prediction-journal.test.mjs",
    "test:heartbeat": "node tests/agent-heartbeat.test.mjs",
    "test:cron": "node tests/cron-scheduler.test.mjs",
    "test:nonce": "node tests/nonce-manager.test.mjs",
    "test:multi-signal": "node tests/multi-signal.test.mjs",
    "test:labels": "node tests/address-labels.test.mjs",
    "test:all": "npm run test:core && npm run test:errors && npm run test:journal && npm run test:heartbeat && npm run test:cron && npm run test:nonce && npm run test:multi-signal && npm run test:labels",
    "lint": "node --input-type=module -e \"import('./scripts/check-deps.mjs')\"",
    "market": "node modules/market/run.mjs",
    "portfolio": "node modules/portfolio/run.mjs",
    "scanner": "node modules/scanner/run.mjs",
    "alerts": "node modules/alerts/run.mjs",
    "analytics": "node modules/analytics/run.mjs",
    "prediction-markets": "node modules/prediction-markets/run.mjs",
    "wallet-ops": "node modules/wallet/run.mjs",
    "defi": "node modules/defi/run.mjs",
    "bridge":      "node modules/bridge/run.mjs",
    "mev":         "node modules/mev/run.mjs",
    "blockchain":  "node modules/blockchain/run.mjs",
    "macro":       "node -e \"import('./core/macro-feed.mjs').then(m=>m.getMacroSignal()).then(s=>console.log(JSON.stringify(s,null,2)))\"",
    "health":      "node -e \"import('./core/health-check.mjs').then(m=>m.runHealthChecks())\"",
    "prices":      "node -e \"import('./core/price-feed.mjs').then(m=>Promise.all(['BTC','ETH','SOL'].map(t=>m.getPrice(t))).then(ps=>console.log(JSON.stringify(ps,null,2))))\"",
    "ledger":      "node -e \"import('./core/audit-ledger.mjs').then(m=>console.log(JSON.stringify(m.computePnl(),null,2)))\"",
    "ledger:csv":  "node -e \"import('./core/audit-ledger.mjs').then(m=>console.log(m.exportCsv()))\"",
    "swarm:list":  "node -e \"import('./core/bootstrap.mjs').then(m=>m.bootstrap({silent:true})).then(r=>console.log(JSON.stringify(r.dispatcher.status(),null,2)))\"",
    "doctor":      "node scripts/jelly-doctor.mjs",
    "journal":     "node -e \"import('./core/prediction-journal.mjs').then(m=>console.log(JSON.stringify(m.computeAccuracy(),null,2)))\"",
    "errors":      "node -e \"import('./core/app-error.mjs').then(m=>console.log(JSON.stringify(Object.keys(m.ERROR_CODES))))\"",
    "cron:status": "node -e \"import('./core/cron-scheduler.mjs').then(m=>console.log(JSON.stringify(m.getCronScheduler().status(),null,2)))\"",
    "heartbeat":   "node -e \"import('./core/agent-heartbeat.mjs').then(m=>console.log(JSON.stringify(m.getHeartbeatSentinel().summary(),null,2)))\"",
    "nonce:status": "node -e \"import('./core/nonce-manager.mjs').then(m=>console.log(JSON.stringify(m.getNonceManager().getState('ethereum',process.env.EVM_WALLET_ADDRESS),null,2)))\"",
    "ws-prices":   "node -e \"import('./core/ws-price-feed.mjs').then(m=>{const f=m.getWsPriceFeed();f.subscribe('SOL',p=>console.log(p));f.subscribe('BTC',p=>console.log(p));f.start()})\""
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bignumber.js": "^9.1.2",
    "boxen": "^8.0.1",
    "bs58": "^6.0.0",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "conf": "^13.0.1",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "eventemitter3": "^5.0.1",
    "ink": "^5.0.0",
    "inquirer": "^12.3.2",
    "lru-cache": "^11.0.2",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^0.66.0",
    "ora": "^8.1.1",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.1",
    "p-timeout": "^6.1.4",
    "react": "^18.0.0",
    "table": "^6.9.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.0.0"
  },
  "keywords": [
    "claude",
    "ai",
    "agent",
    "solana",
    "bnb",
    "polymarket",
    "kalshi",
    "prediction-markets",
    "defi",
    "trading"
  ]
}
